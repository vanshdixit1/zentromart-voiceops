VOICEOPS_DATASET=dataset/Capstone_Project_Dataset_FTTT_2026

# Google AI Studio Gemini chat model
GEMINI_API_KEY=your_gemini_api_key_here
# Optional failover key from a different Google AI Studio project.
GEMINI_FALLBACK_API_KEY=your_fallback_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Set 4.1 to stay under a 15-requests/minute Gemini free-tier limit; 0 disables spacing.
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=4.1

# Optional: OpenAI-compatible embeddings. Without these credentials, retrieval
# uses the built-in lexical fallback; the embedding model and vector index stay unchanged.
# OPENAI_TIMEOUT_SECONDS applies only to this optional embedding endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60

# Gnani is the only permitted speech provider for both listening and speaking.
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# Required only for serverless hosting; generate a private Fernet key.
# VOICEOPS_SESSION_KEY=replace_with_a_random_fernet_key
