{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?__voiceops_route=/" },
    { "source": "/assets/:path*", "destination": "/api/index?__voiceops_route=/assets/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__voiceops_route=/api/:path*" }
  ]
}
